{
  "v1": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Workspace Configuration",
    "description": "Schema definition for workspace configuration information",
    "type": "object",
    "properties": {
      "version": {
        "type": "string",
        "description": "Workspace version",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "description": "Workspace name",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "description": "Workspace description"
      },
      "dir_map": {
        "type": "object",
        "description": "Directory mapping relationships",
        "additionalProperties": {
          "type": "string",
          "pattern": "^/.+"
        },
        "minProperties": 1
      },
      "file_map": {
        "type": "object",
        "description": "File mapping relationships",
        "additionalProperties": {
          "type": "string",
          "pattern": "^[^/\\*?\"<>|]+$"
        },
        "minProperties": 1
      }
    },
    "required": [
      "name",
      "dir_map",
      "file_map"
    ],
    "additionalProperties": false
  }
}